
user_config = {
    "theme": "dark",
    "language": "english"
}


def add_setting(settings, new_data):
    setting, value = new_data

    setting = setting.lower()
    value = value.lower()

    if settings.get(setting) is not None:
        return f"Setting '{setting}' already exists! Cannot add a new setting with this name."

    settings[setting] = value

    return f"Setting '{setting}' added with value '{value}' successfully!"


def update_setting(settings, new_data):
    setting, value = new_data

    setting = setting.lower()
    value = value.lower()

    if setting not in settings.keys():
        return f"Setting '{setting}' does not exist! Cannot update a non-existing setting."

    settings.update({setting: value})

    return f"Setting '{setting}' updated to '{value}' successfully!"


def delete_setting(settings, setting):
    setting = setting.lower()

    removed = settings.pop(setting, None)

    if removed is None:
        return "Setting not found!"

    return f"Setting '{setting}' deleted successfully!"


def view_settings(settings):
    if len(settings) == 0:
        return "No settings available."

    result = "Current User Settings:\n"

    for name in settings:
        result += f"{name.title()}: {settings[name]}\n"

    return result
